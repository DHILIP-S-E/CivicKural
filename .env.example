# --- AWS ---
AWS_REGION=ap-south-1
WARDWATCH_TABLE=wardwatch
WARDWATCH_BUCKET=wardwatch-media-dev

# --- Bedrock model IDs ---
# Amazon Nova Lite works on-demand with no console approval step and supports
# vision. Anthropic Claude models on Bedrock require a one-time "model use case"
# form (Console > Bedrock > Model access) before they can be invoked — swap in
# a Claude inference profile ID here once that's approved.
BEDROCK_REASONING_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_VISION_MODEL_ID=apac.amazon.nova-lite-v1:0

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# --- WhatsApp Business Cloud API (sandbox) ---
# Leave WHATSAPP_TOKEN empty to use the in-process FakeWhatsApp client.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE=https://graph.facebook.com/v20.0

# --- Citizen WhatsApp OTP through AWS End User Messaging Social ---
# Link a Meta WABA in AWS, register its phone number, and create an approved
# Authentication template before setting these values.
WHATSAPP_AWS_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=wardwatch_login_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_META_API_VERSION=v20.0

# --- SES ---
SES_SENDER=wardwatch@example.org

# --- SNS SMS ---
# Reuses AWS_REGION above (no separate SNS region setting). Leave SNS_ENABLED
# unset/false to use the in-process FakeSns client.
SNS_ENABLED=false

# --- Tenant defaults ---
DEFAULT_TENANT_ID=MDU-CORP

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
